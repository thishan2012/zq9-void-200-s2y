# Copy to .env for local runs (git-ignored). In GitHub, use repository Secrets instead.
# See Instructions/SECRETS.md for how to obtain each value.
# Leave optional values empty if you do not use them.

# --- Spotify (required for Spotify sync) ---
SPOTIFY_COOKIE=
SPOTIFY_SOURCE_PLAYLISTS=
SPOTIFY_TARGET_PLAYLIST=

# Optional spare Spotify accounts / browser-token helpers
SPOTIFY_COOKIE_2=
SPOTIFY_COOKIE_3=
SPOTIFY_COOKIE_4=
SPOTIFY_TOTP_VER=
SPOTIFY_TOTP_CIPHER=
SPOTIFY_WEB_TOKEN=
SPOTIFY_ENCRYPTED_TOKEN=
SPOTIFY_PROXY_URL=
SPOTIFY_PROXY_SECRET=

# --- Telegram logs (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube (only if YOUTUBE_ENABLED=true) ---
YOUTUBE_ENABLED=
YOUTUBE_TARGET_PLAYLIST=
YOUTUBE_API_KEY=
YT_API_KEY=

# YouTube writes: OAuth refresh token (long-lived) OR browser cookie
YT_REFRESH_TOKEN=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_CLIENT_JSON=
YT_TOKEN_JSON=
YOUTUBE_OAUTH_TOKEN_JSON=
YOUTUBE_TOKEN_JSON=
YT_OAUTH_TOKEN_JSON=
YT_ACCESS_TOKEN=
YT_COOKIE=
YT_AUTHUSER=

# --- Spare YouTube OAuth accounts (optional) ---
# Used ONLY after the previous account returns 403 quotaExceeded.
# Each must be a DIFFERENT Google Cloud project (quota is per project).
# Numbered secrets _2 .. _5 are read by the workflow; gaps are fine.
YT_CLIENT_ID_2=
YT_CLIENT_SECRET_2=
YT_REFRESH_TOKEN_2=
# Have the JSON file? Paste the WHOLE download into ONE of these and add
# "refresh_token": "1//..." to it. No need to copy individual values out.
YT_CLIENT_JSON_2=
YT_TOKEN_JSON_2=
YOUTUBE_OAUTH_TOKEN_JSON_2=
YT_CLIENT_ID_3=
YT_CLIENT_SECRET_3=
YT_REFRESH_TOKEN_3=
# ...or put every spare in ONE secret as a JSON list (no count limit):
# [{"client_id":"...","client_secret":"...","refresh_token":"..."}]
YOUTUBE_OAUTH_ACCOUNTS=
